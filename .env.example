# Google Analytics 4 — set before production launch
VITE_GA_MEASUREMENT_ID=

# Google AdSense — set when applying for approval
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_PUBLISHER_ID=

# AdSense 광고 단위 ID (data-ad-slot)
# 애드센스 승인 후 대시보드 > 광고 > 광고 단위 기준에서 "디스플레이 광고"를 만들면
# 발급되는 숫자 ID(예: 1234567890)를 넣는다. 임의 문자열을 넣으면 광고 요청이
# 성립하지 않으므로 반드시 대시보드에서 발급받은 값이어야 한다.
# 비워두면 해당 위치의 광고 슬롯이 렌더링되지 않는다(잘못된 광고 요청 방지).
VITE_ADSENSE_SLOT_BLOG_DETAIL=
VITE_ADSENSE_SLOT_SUPPORT_DETAIL=
VITE_ADSENSE_SLOT_BLOG_LIST=
VITE_ADSENSE_SLOT_CALCULATOR=
